{
  "manifest_version": 3,
  "name": "TalkBridge - Universal Video Translator",
  "version": "1.0.0",
  "description": "Real-time video translation with AI voice dubbing for YouTube, Netflix, and all video sites",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "tabCapture",
    "desktopCapture",
    "offscreen"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/audio-capture.js", "content/tab-audio-capture.js", "content/content-autoplay.js"],
      "css": ["content/content-startup.css"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "minimum_chrome_version": "109"
}
